{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "eara/form-long-text",
  "title": "Long Text Field",
  "category": "eara",
  "icon": "editor-paragraph",
  "description": "A multi-line textarea input field.",
  "parent": ["eara/form-container"],
  "supports": {
    "html": false
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Message"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "placeholder": {
      "type": "string",
      "default": ""
    },
    "required": {
      "type": "boolean",
      "default": false
    },
    "rows": {
      "type": "number",
      "default": 4
    }
  },
  "textdomain": "eara",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./styles.scss"
}
